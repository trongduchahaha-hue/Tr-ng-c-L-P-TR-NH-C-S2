#include <stdio.h>
#include <math.h>

int main() {

    int a = 2;
    int b = 5;
    int c = 3;
    double S;

    S = (pow(a, 2) + sqrt(pow(b, 2) + 4 * a * c)) / (2.0 * a) 
        - (pow(b, 3) / pow(c, 2)) 
        + sqrt(fabs(a - b));

    printf("Input: a = %d, b = %d, c = %d\n", a, b, c);
    printf("Output: S = (a^2 + sqrt(b^2 + 4ac)) / 2a - (b^3 / c^2) + sqrt(|a - b|) = %.2f\n", S);

    return 0;
}
